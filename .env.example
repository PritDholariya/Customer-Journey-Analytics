# ─────────────────────────────────────────────────────────────────────────────
# .env.example  —  Template for environment variables
#
# THIS FILE IS COMMITTED TO GIT. It shows other developers what variables
# they need to set, but contains NO real credentials (only placeholders).
#
# HOW TO USE:
#   1. Copy this file:   cp .env.example .env
#   2. Fill in your real values in .env
#   3. Never commit .env  (it is already in .gitignore)
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection settings
DB_HOST=localhost          # Hostname where PostgreSQL is running
DB_PORT=5432               # Default PostgreSQL port
DB_NAME=your_database_name # Name of the database to connect to
DB_USER=your_db_username   # PostgreSQL username
DB_PASSWORD=your_password  # PostgreSQL password — keep this secret!
